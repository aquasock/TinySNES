// SDRAM clock enable.  SNESTang's console.cst does not constrain this pin --
// Gowin's fitter placed it wherever it liked -- and the Console's SDRAM module
// ties CKE high itself, so the signal only has to reach a pad rather than a
// particular one.  It sat on PMOD1_IO0 (W19) until the Pmod I2S2 needed that
// pad: the module's pin 1 is MCLK, which is fixed by the hardware, so CKE moves
// to PMOD1_IO1 instead.  Pins 7-10 are unused on a Pmod I2S2, so nothing
// collides there.
IO_LOC "O_sdram_cke" W20;
IO_PORT "O_sdram_cke" IO_TYPE=LVCMOS33;

IO_LOC "O_sdram_clk" B17;
IO_PORT "O_sdram_clk" IO_TYPE=LVCMOS33;
IO_LOC "O_sdram_wen_n" D16;
IO_PORT "O_sdram_wen_n" IO_TYPE=LVCMOS33;
IO_LOC "O_sdram_ras_n" F16;
IO_PORT "O_sdram_ras_n" IO_TYPE=LVCMOS33;
IO_LOC "O_sdram_cas_n" E17;
IO_PORT "O_sdram_cas_n" IO_TYPE=LVCMOS33;
IO_LOC "O_sdram_cs_n" F21;      // was F19 on mega60k
IO_PORT "O_sdram_cs_n" IO_TYPE=LVCMOS33;