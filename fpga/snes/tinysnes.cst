// TinySNES pins for the Tang Console 138K.
// SPDX-License-Identifier: GPL-3.0-only
//
// Taken from SNESTang's src/boards/console.cst (nand2mario), the file its
// own console138k build uses, with the USB HID, DualShock and SNES
// controller pins dropped: this core takes its pads over the BL616 UART
// link.  Pin assignments are unchanged, so the board's HDMI, SDRAM,
// UART, button and LED wiring is exactly what SNESTang was tested on.

// Clock placement, copied from TinyNES's ae350_soc.cst and TinyTang's
// desktop.cst, which run HDMI on this board.  The serial-clock PLL sits at
// PLL_R[3] beside the TMDS pins with its 27 MHz reference at PLL_R[1], and the
// pixel-clock divider goes in the right side's HCLK block (block 1, lane 0);
// left to the placer it lands in block 0, from where the pixel clock does not
// route to the OSER10s.
//
// TinySNES: pll_snes moved from PLL_R[0] to PLL_L[0].  apicula's
// `_gw5a_pll_clk_wires` table for GW5AST-138C gives the right-edge site one
// clock-plane wire, CLKOUT0 (TRPLL0CLK0), and the left-edge site two, CLKOUT0
// (TLPLL0CLK0) and CLKOUT2 (TLPLL0CLK2).  This design needs two global clocks
// out of one PLL -- mclk for the machine and fclk for the SDRAM controller --
// so it has to sit on the site that offers two.  Measured on the routed netlist
// before the move: `iosys.clk` entered through TRPLL0CLK0 while `fclk` carried
// no bridge pip at all and was routed point to point across 18,400 characters.
// TinyGBA measured TLPLL0CLK2 against the vendor flow on 2026-10-31 and found
// it clocks 48 GB00 sinks.  See core-log entry 75 and TCL-015.
INS_LOC "pll_snes.PLL_inst" PLL_L[0];
INS_LOC "pll_27.PLL_inst" PLL_R[1];
INS_LOC "pll_hdmi.PLL_inst" PLL_R[3];
INS_LOC "div5" RIGHTSIDE[4];

IO_LOC "sys_clk" V22;
IO_PORT "sys_clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=OFF;

IO_LOC "s0" AA13;        // active low
IO_PORT "s0" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=OFF BANK_VCCIO=3.3;
// IO_LOC "s1" AB13;       
// IO_PORT "s1" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=OFF BANK_VCCIO=3.3;
// IO_LOC "s2" Y12;        
// IO_PORT "s2" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=OFF BANK_VCCIO=3.3;

// HDMI
IO_LOC "tmds_clk_p" G15;
IO_PORT "tmds_clk_p" PULL_MODE=NONE IO_TYPE=LVCMOS33D;
IO_LOC "tmds_clk_n" G16;
IO_PORT "tmds_clk_n" PULL_MODE=NONE IO_TYPE=LVCMOS33D;
IO_LOC "tmds_d_p[0]" J14;
IO_PORT "tmds_d_p[0]" PULL_MODE=NONE IO_TYPE=LVCMOS33D;
IO_LOC "tmds_d_n[0]" H14;
IO_PORT "tmds_d_n[0]" PULL_MODE=NONE IO_TYPE=LVCMOS33D;
IO_LOC "tmds_d_p[1]" J15;
IO_PORT "tmds_d_p[1]" PULL_MODE=NONE IO_TYPE=LVCMOS33D;
IO_LOC "tmds_d_n[1]" H15;
IO_PORT "tmds_d_n[1]" PULL_MODE=NONE IO_TYPE=LVCMOS33D;
IO_LOC "tmds_d_p[2]" K17;
IO_PORT "tmds_d_p[2]" PULL_MODE=NONE IO_TYPE=LVCMOS33D;
IO_LOC "tmds_d_n[2]" J17;
IO_PORT "tmds_d_n[2]" PULL_MODE=NONE IO_TYPE=LVCMOS33D;

// UART to BL616
IO_LOC "UART_RXD" V14;
IO_LOC "UART_TXD" U15;
IO_PORT "UART_RXD" IO_TYPE=LVCMOS33;
IO_PORT "UART_TXD" IO_TYPE=LVCMOS33;

// USB1 and USB2 (usb1 is on the left)

// usb1's data pair carries a Wii Classic Controller's I2C bus, through
// Adafruit's Wii Nunchuck Breakout Adapter fed from this port's VBUS: D+ is
// SDA (H13) and D- is SCL (G13), as TinyNES wires controller 1 on this same
// board.  The adapter level-shifts and only pulls each line low, so both are
// open drain and the pull-ups are what make them idle high.  Nothing else on
// this board uses usb1.
IO_LOC  "usb1_dp" H13;
IO_PORT "usb1_dp" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC  "usb1_dn" G13;
IO_PORT "usb1_dn" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// Pmod I2S2 on PMOD1, seated normally: Digilent pins 1-4 are Sipeed PMOD1_IO0,
// IO2, IO4 and IO6, the DAC's MCLK, LRCK, SCLK and SDIN -- the same pins and the
// same module TinyNES and TinyGBC use on this board.  The CS4344 takes
// MCLK = 256 x Fs, so 12.5 MHz here is 48,828 Hz.
IO_LOC  "pmod1_dac[0]" W19;
IO_PORT "pmod1_dac[0]" IO_TYPE=LVCMOS33;
IO_LOC  "pmod1_dac[1]" F19;
IO_PORT "pmod1_dac[1]" IO_TYPE=LVCMOS33;
IO_LOC  "pmod1_dac[2]" E22;
IO_PORT "pmod1_dac[2]" IO_TYPE=LVCMOS33;
IO_LOC  "pmod1_dac[3]" E21;
IO_PORT "pmod1_dac[3]" IO_TYPE=LVCMOS33;

// Joystick on pmod1


// LED on pmod0
IO_LOC  "led[0]" B22;   // PMOD0_IO7
IO_LOC  "led[1]" C22;   // PMOD0_IO6
IO_LOC  "led[2]" E18;   // PMOD0_IO5
IO_LOC  "led[3]" F18;   // PMOD0_IO4
IO_LOC  "led[4]" G22;   // PMOD0_IO3
IO_LOC  "led[5]" G21;   // PMOD0_IO2
IO_LOC  "led[6]" V19;   // PMOD0_IO1
IO_LOC  "led[7]" V18;   // PMOD0_IO0
IO_PORT "led[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "led[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "led[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "led[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "led[4]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "led[5]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "led[6]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "led[7]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

